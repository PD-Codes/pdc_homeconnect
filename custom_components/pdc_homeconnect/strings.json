  "services": {
    "notify": {
      "name": "Send notification",
      "description": "Shows a Windows notification on the PC.",
      "fields": {
        "device_id": {
          "name": "PC",
          "description": "The PC(s) to send this action to."
        },
        "message": {
          "name": "Message",
          "description": "Text of the notification."
        },
        "title": {
          "name": "Title",
          "description": "Title of the notification."
        },
        "image": {
          "name": "Image",
          "description": "Camera entity (camera.xyz), image URL or /local/... path."
        },
        "actions": {
          "name": "Buttons",
          "description": "Up to 5 buttons: a list of {action, title}. A click fires the notification action event."
        },
        "reply": {
          "name": "Reply field",
          "description": "Placeholder text for a reply text box. The reply fires the notification action event."
        },
        "scenario": {
          "name": "Scenario",
          "description": "Reminder and alarm stay on screen until dismissed."
        },
        "sound": {
          "name": "Sound",
          "description": "Notification sound."
        },
        "duration": {
          "name": "Duration",
          "description": "How long the notification stays on screen."
        },
        "tag": {
          "name": "Tag",
          "description": "Identifier to replace or clear this notification later."
        },
        "fullscreen_fallback": {
          "name": "Fullscreen fallback",
          "description": "What to do when Windows hides notifications because a fullscreen app or game is running."
        }
      }
    },
    "clear_notifications": {
      "name": "Clear notifications",
      "description": "Removes notifications from the Windows notification center.",
      "fields": {
        "device_id": {
          "name": "PC",
          "description": "The PC(s) to send this action to."
        },
        "tag": {
          "name": "Tag",
          "description": "Only remove the notification with this tag. Leave empty to remove all."
        }
      }
    },
    "open_url": {
      "name": "Open URL",
      "description": "Opens a URL with its default app (browser, Steam, Discord, ...).",
      "fields": {
        "device_id": {
          "name": "PC",
          "description": "The PC(s) to send this action to."
        },
        "url": {
          "name": "URL",
          "description": "The URL to open. Allowed schemes are configured on the PC."
        }
      }
    },
    "speak": {
      "name": "Speak",
      "description": "Reads a text aloud on the PC using a Windows voice.",
      "fields": {
        "device_id": {
          "name": "PC",
          "description": "The PC(s) to send this action to."
        },
        "message": {
          "name": "Message",
          "description": "Text to speak."
        },
        "language": {
          "name": "Language",
          "description": "Voice language, e.g. de-DE or en-US."
        }
      }
    },
    "set_clipboard": {
      "name": "Set clipboard",
      "description": "Copies text to the clipboard of the PC.",
      "fields": {
        "device_id": {
          "name": "PC",
          "description": "The PC(s) to send this action to."
        },
        "text": {
          "name": "Text",
          "description": "Text to copy."
        }
      }
    },
    "power": {
      "name": "Power action",
      "description": "Shuts down, restarts or suspends the PC, optionally with a delay.",
      "fields": {
        "device_id": {
          "name": "PC",
          "description": "The PC(s) to send this action to."
        },
        "action": {
          "name": "Action",
          "description": "What to do."
        },
        "delay": {
          "name": "Delay",
          "description": "Seconds to wait (the user sees a warning)."
        },
        "force": {
          "name": "Force",
          "description": "Close apps without asking (unsaved work is lost)."
        }
      }
    },
    "run_command": {
      "name": "Run command",
      "description": "Runs a command that is defined in the client configuration on the PC.",
      "fields": {
        "device_id": {
          "name": "PC",
          "description": "The PC(s) to send this action to."
        },
        "command": {
          "name": "Command",
          "description": "Id of the command from the PC configuration."
        }
      }
    },
    "vm_control": {
      "name": "Control virtual machine",
      "description": "Starts, stops, saves or pauses a Hyper-V virtual machine.",
      "fields": {
        "device_id": {
          "name": "PC",
          "description": "The PC(s) to send this action to."
        },
        "vm": {
          "name": "Virtual machine",
          "description": "Name of the virtual machine."
        },
        "action": {
          "name": "Action",
          "description": "What to do."
        }
      }
    },
    "service_control": {
      "name": "Control Windows service",
      "description": "Starts, stops or restarts a watched Windows service.",
      "fields": {
        "device_id": {
          "name": "PC",
          "description": "The PC(s) to send this action to."
        },
        "service": {
          "name": "Service",
          "description": "Service name (must be in the watched services list on the PC)."
        },
        "action": {
          "name": "Action",
          "description": "What to do."
        }
      }
    }
