<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Windows service (LocalSystem). Hosts the Home Assistant endpoint, system level sensors,
    power actions, server modules and the bridge to the tray agents.
    WinExe: never shows a console window.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>PdcHomeConnect.Service</RootNamespace>
    <AssemblyName>PdcHomeConnect.Service</AssemblyName>
    <ApplicationIcon>..\..\installer\assets\app.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);SYSLIB1054;SYSLIB1096</NoWarn>
    <InvariantGlobalization>false</InvariantGlobalization>
    <IsPackable>false</IsPackable>
    <!-- Not hosted in IIS: no web.config in the publish output. -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" />
    <PackageReference Include="System.Management" />
    <PackageReference Include="System.ServiceProcess.ServiceController" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdcHomeConnect.Core\PdcHomeConnect.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="service.default.jsonc" LogicalName="service.default.jsonc" />
  </ItemGroup>

</Project>
